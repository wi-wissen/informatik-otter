---
// Short code for the board, a share button and a QR code (rendered at build time).
import QRCode from 'qrcode';
import { SITE } from '../lib/tasks';
interface Props { short: string; title: string }
const { short, title } = Astro.props;
const url = `${SITE}/${short}`;
const svg = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#10313a', light: '#ffffff' } });
---
<section class="share" aria-label="Teilen">
  <h2>Code für die Klasse</h2>
  <p class="code" translate="no">{short}</p>
  <p class="hint">auf {new URL(SITE).host} eingeben</p>
  <div class="row">
    <button type="button" class="btn secondary small" data-share={url} data-title={title}>Link teilen</button>
    <details>
      <summary class="btn secondary small">QR-Code</summary>
      <div class="qr" set:html={svg} />
    </details>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      const url = b.dataset.share!;
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) { await navigator.share({ title: b.dataset.title, url }); return; }
        await navigator.clipboard.writeText(url);
        b.textContent = 'Link kopiert';
      } catch { b.textContent = url; }
      setTimeout(() => (b.textContent = label), 2000);
    });
  });
</script>
<style>
  .share { display: grid; gap: 4px; }
  h2 { font: 700 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .code { font: 700 2.4rem/1.1 var(--font-mono); color: var(--primary); letter-spacing: .06em; }
  .hint { font-size: .85rem; color: var(--muted); margin-bottom: 10px; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: start; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .qr { margin-top: 10px; width: 200px; background: #fff; border-radius: 10px; padding: 8px; }
  .qr :global(svg) { width: 100%; height: auto; display: block; }
</style>
