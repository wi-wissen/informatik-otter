---
// Short code in the sidebar; "Teilen" opens a dialog with the full link (for copying from the board) and a QR code.
import QRCode from 'qrcode';
import { SITE } from '../lib/tasks';
interface Props { short: string; title: string }
const { short, title } = Astro.props;
const url = `${SITE}/${short}`;
const host = new URL(SITE).host;
const svg = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#10313a', light: '#ffffff' } });
---
<section class="share" aria-label="Teilen">
  <h2>Code für die Klasse</h2>
  <div class="row">
    <p class="code" translate="no">{short}</p>
    <button type="button" class="btn secondary small" data-open-share>Teilen</button>
  </div>
  <p class="hint">auf {host} eingeben</p>
</section>

<dialog class="share-dialog" aria-labelledby="share-title">
  <header class="bar">
    <h2 id="share-title">{title}</h2>
    <button type="button" class="close" data-close aria-label="Schließen">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
    </button>
  </header>
  <div class="body">
    <p class="link" translate="no"><span class="dim">https://</span>{host}/<b>{short}</b></p>
    <div class="qr" set:html={svg} />
  </div>
  <footer class="actions">
    <button type="button" class="btn secondary small" data-copy={url}>Link kopieren</button>
  </footer>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-share]').forEach((b) => {
    const dialog = b.closest('section')!.nextElementSibling as HTMLDialogElement;
    b.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.querySelectorAll('[data-close]').forEach((c) => c.addEventListener('click', () => dialog.close()));
    const copy = dialog.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(copy.dataset.copy!); copy.textContent = 'Kopiert'; }
      catch { copy.textContent = 'Bitte Link markieren'; }
      setTimeout(() => (copy.textContent = 'Link kopieren'), 2000);
    });
  });
</script>
<style>
  .share { display: grid; gap: 2px; }
  h2 { font: 700 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .code { font: 700 2.4rem/1.1 var(--font-mono); color: var(--primary); letter-spacing: .06em; }
  .hint { font-size: .85rem; color: var(--muted); }

  /* Share dialog: fills the screen so link and QR code are readable on a projector. */
  .share-dialog { border: 0; border-radius: 20px; padding: 0; background: var(--surface); color: var(--ink);
    width: calc(100vw - 32px); height: calc(100dvh - 32px); max-width: none; max-height: none; }
  .share-dialog[open] { display: flex; flex-direction: column; }
  .share-dialog::backdrop { background: rgba(6, 20, 24, .7); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px 14px clamp(16px, 3vw, 32px); border-bottom: 1px solid var(--line); }
  .bar h2 { margin: 0; font: 600 clamp(1.1rem, 2.4vw, 1.8rem)/1.2 var(--font-display); letter-spacing: 0; text-transform: none; color: var(--ink); }
  .close { flex: none; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: var(--sunk); color: var(--ink); cursor: pointer; }
  .body { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; gap: clamp(12px, 3vh, 32px); padding: clamp(16px, 3vh, 36px) clamp(16px, 3vw, 32px); container-type: inline-size; }
  /* ~38 monospace characters: 4.2cqi makes the line fill the width */
  .link { margin: 0; font: 600 clamp(1rem, 4.2cqi, 7rem)/1.15 var(--font-mono); white-space: nowrap; text-align: center; }
  .link .dim { color: var(--muted); opacity: .5; font-weight: 500; }
  .link b { color: var(--primary); }
  .qr { flex: 1; min-height: 0; width: 100%; display: flex; justify-content: center; }
  .qr :global(svg) { height: 100%; width: auto; max-width: 100%; aspect-ratio: 1; background: #fff; border-radius: 12px; padding: 10px; }
  .actions { display: flex; justify-content: center; padding: 12px; border-top: 1px solid var(--line); }
</style>
