---
// Short code in the sidebar; "Teilen" opens a dialog with the full link (for copying from the board) and a QR code.
import QRCode from 'qrcode';
import { SITE } from '../lib/tasks';
interface Props { short: string; title: string }
const { short, title } = Astro.props;
const url = `${SITE}/${short}`;
const host = new URL(SITE).host;
const svg = await QRCode.toString(url, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#10313a', light: '#ffffff' } });
---
<section class="share" aria-label="Teilen">
  <h2>Code für die Klasse</h2>
  <div class="row">
    <p class="code" translate="no">{short}</p>
    <button type="button" class="btn secondary small" data-open-share>Teilen</button>
  </div>
  <p class="hint">auf {host} eingeben</p>
</section>

<dialog class="share-dialog" aria-labelledby="share-title">
  <div class="inner">
    <div class="top">
      <h2 id="share-title">{title}</h2>
      <button type="button" class="close" data-close aria-label="Schließen">×</button>
    </div>
    <p class="link" translate="no"><span class="dim">https://</span>{host}/<b>{short}</b></p>
    <div class="qr" set:html={svg} />
    <div class="actions">
      <button type="button" class="btn small" data-copy={url}>Link kopieren</button>
      <button type="button" class="btn secondary small" data-close>Schließen</button>
    </div>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open-share]').forEach((b) => {
    const dialog = b.closest('section')!.nextElementSibling as HTMLDialogElement;
    b.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.querySelectorAll('[data-close]').forEach((c) => c.addEventListener('click', () => dialog.close()));
    const copy = dialog.querySelector<HTMLButtonElement>('[data-copy]')!;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(copy.dataset.copy!); copy.textContent = 'Kopiert'; }
      catch { copy.textContent = 'Bitte Link markieren'; }
      setTimeout(() => (copy.textContent = 'Link kopieren'), 2000);
    });
  });
</script>
<style>
  .share { display: grid; gap: 2px; }
  h2 { font: 700 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .code { font: 700 2.4rem/1.1 var(--font-mono); color: var(--primary); letter-spacing: .06em; }
  .hint { font-size: .85rem; color: var(--muted); }

  .share-dialog { border: 0; border-radius: 20px; padding: 0; background: var(--surface); color: var(--ink); width: min(880px, calc(100vw - 32px)); max-height: calc(100vh - 32px); }
  .share-dialog::backdrop { background: rgba(6, 20, 24, .6); }
  .inner { display: grid; gap: 22px; justify-items: center; padding: clamp(20px, 4vw, 40px); text-align: center; }
  .top { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; width: 100%; }
  .top h2 { font: 600 1.4rem var(--font-display); letter-spacing: 0; text-transform: none; color: var(--ink); text-align: left; }
  .close { display: grid; place-items: center; padding: 0; border: 0; background: var(--sunk); color: var(--ink); width: 40px; height: 40px; border-radius: 50%; font-size: 1.6rem; line-height: 1; cursor: pointer; }
  .link { font: 600 clamp(.8rem, 3.2vw, 2rem)/1.3 var(--font-mono); white-space: nowrap; max-width: 100%; overflow: hidden; }
  .link .dim { color: var(--muted); opacity: .55; font-weight: 500; }
  .link b { color: var(--primary); }
  .qr { width: min(320px, 70vw); background: #fff; border-radius: 14px; padding: 10px; }
  .qr :global(svg) { width: 100%; height: auto; display: block; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
</style>
