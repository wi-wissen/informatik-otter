---
// Task body + interaction. Used on /tasks/<id>/ and on the short-link page.
import { render } from 'astro:content';
import TaskPlayer from './TaskPlayer.vue';
import { resolveAssets, type TaskEntry } from '../lib/tasks';

interface Props { task: TaskEntry }
const { task } = Astro.props;
const { Content } = await render(task);
const props = resolveAssets(task.id, task.data.interaction.props ?? {});
---
<article class="task">
  <h1>{task.data.title}</h1>
  <div class="prose body"><Content /></div>
  <div class="play">
    <TaskPlayer client:load taskId={task.id} format={task.data.interaction.format} props={props as Record<string, unknown>} solutionUrl={`/solutions/${task.id}/`} />
  </div>
</article>
<style>
  .task { display: grid; gap: 18px; }
  h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); }
  .body { font-size: 1.05rem; }
  .play { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; min-width: 0; overflow-x: auto; }
</style>
