---
import Base from '../../layouts/Base.astro';
import TaskView from '../../components/TaskView.astro';
import ShareBox from '../../components/ShareBox.astro';
import { getTasks, label, formatLabel, sourceNote } from '../../lib/tasks';

export async function getStaticPaths() {
  return (await getTasks()).map((task) => ({ params: { id: task.id }, props: { task } }));
}
const { task } = Astro.props;
const d = task.data;
---
<Base title={d.title} description={d.summary} footerSource={sourceNote(task)} footerSourceHref={d.source.url}>
  <div class="in layout">
    <div class="main"><TaskView task={task} /></div>
    <aside>
      <dl class="meta">
        <dt>Klassen</dt><dd>{Object.entries(d.grades).map(([g, diff]) => <a class="chip sun" href={`/tasks/?grade=${g}`} title={`Alle Aufgaben für Klasse ${g}`}>{g}: {label.difficulty(diff)}</a>)}</dd>
        <dt>Themen</dt><dd>{d.topics.map((t) => <a class="chip" href={`/tasks/?topic=${t}`} title={`Alle Aufgaben zum Thema ${label.topic(t)}`}>{label.topic(t)}</a>)}</dd>
        <dt>GI-Inhaltsbereich</dt><dd>{d.gi.content.map((c) => <a class="chip outline" href={`/topics/#${c}`} title="Themen dieses Inhaltsbereichs">{label.giContent(c)}</a>)}</dd>
        {d.gi.process.length > 0 && <><dt>GI-Prozessbereich</dt><dd>{d.gi.process.map((p) => <span class="chip outline">{label.giProcess(p)}</span>)}</dd></>}
        {d.methods.length > 0 && <><dt class="teacher-only">Verfahren</dt><dd class="teacher-only">{d.methods.map((m) => <a class="chip method" href={`/tasks/?q=${encodeURIComponent(label.method(m).replace(/ \(.*\)$/, ''))}`} title="Alle Aufgaben mit diesem Verfahren">#{label.method(m)}</a>)}</dd></>}
        <dt>Format</dt><dd><a class="chip outline" href={`/tasks/?format=${d.interaction.format}`} title="Alle Aufgaben mit diesem Format">{formatLabel[d.interaction.format]}</a></dd>
      </dl>
      <ShareBox short={d.short} title={d.title} />
    </aside>
  </div>
</Base>
<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 32px; padding-block: 20px 0; align-items: start; }
  aside { display: grid; gap: 22px; position: sticky; top: 16px; padding-top: 4px; }
  .meta { margin: 0; display: grid; gap: 6px; }
  dt { font: 700 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .src { display: block; font-size: .9rem; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } aside { position: static; } }
</style>
