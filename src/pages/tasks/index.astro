---
import Base from '../../layouts/Base.astro';
import TaskCard from '../../components/TaskCard.astro';
import { getTasks, label, formatLabel } from '../../lib/tasks';
import taxonomy from '../../data/taxonomy.json';

const tasks = await getTasks();
const used = (pick: (t: (typeof tasks)[number]) => string[]) => new Set(tasks.flatMap(pick));
const usedTopics = used((t) => t.data.topics);
const gis = Object.keys(taxonomy.giContent).filter((k) => used((t) => t.data.gi.content).has(k));
const topicsByGi = gis.map((gi) => ({
  gi,
  topics: Object.entries(taxonomy.topics).filter(([k, t]) => t.gi === gi && usedTopics.has(k)).map(([k]) => k),
})).filter((g) => g.topics.length);
const formats = Object.keys(formatLabel).filter((k) => used((t) => [t.data.interaction.format]).has(k));
const single = [
  { key: 'format', title: 'Format', options: formats.map((k) => [k, formatLabel[k]]) },
  { key: 'source', title: 'Quelle', options: [['original', 'Informatik-Biber'], ['synthetic', 'Otter-Varianten']] },
];
---
<Base title="Aufgaben" description="Alle Knobelaufgaben, filterbar nach Klasse, GI-Inhaltsbereich und Thema.">
  <div class="in catalog">
    <aside class="facets" aria-label="Filter">
      <fieldset data-facet="grades" data-mode="one">
        <legend>Klassenstufe</legend>
        <div class="chips">{Object.keys(taxonomy.grades).map((g) => <button type="button" class="chip outline" data-value={g} aria-pressed="false">{g}</button>)}</div>
      </fieldset>
      <fieldset data-facet="gi" data-mode="one">
        <legend>GI-Inhaltsbereich</legend>
        <div class="stack">{gis.map((g) => <button type="button" class="chip outline wide" data-value={g} aria-pressed="false">{label.giContent(g)}</button>)}</div>
      </fieldset>
      <fieldset data-facet="topics" data-mode="all">
        <legend>Thema</legend>
        {topicsByGi.map((grp) => (
          <div class="group" data-gi-group={grp.gi}>
            <span class="sub">{label.giContent(grp.gi)}</span>
            <div class="chips">{grp.topics.map((k) => <button type="button" class="chip outline" data-value={k} aria-pressed="false">{label.topic(k)}</button>)}</div>
          </div>
        ))}
        <p class="note">Mehrere Themen: nur Aufgaben, die alle gewählten Themen haben. Die Zahl zeigt, wie viele übrig bleiben.</p>
      </fieldset>
      <details class="more">
        <summary>Weitere Filter</summary>
        {single.map((f) => (
          <fieldset data-facet={f.key} data-mode="one">
            <legend>{f.title}</legend>
            <div class="chips">{f.options.map(([v, l]) => <button type="button" class="chip outline" data-value={v} aria-pressed="false">{l}</button>)}</div>
          </fieldset>
        ))}
      </details>
    </aside>
    <section class="results">
      <div class="head">
        <h1>Aufgaben</h1>
        <label class="search"><span aria-hidden="true">⌕</span><input id="q" type="search" placeholder="Suchen, z. B. Geheimschrift" aria-label="Aufgaben durchsuchen" /></label>
        <p class="count muted" aria-live="polite"><span id="count">{tasks.length}</span> von {tasks.length} Aufgaben · <button type="button" id="reset" class="linkish">Filter zurücksetzen</button></p>
      </div>
      <div class="grid" id="grid">{tasks.map((t) => <TaskCard task={t} />)}</div>
      <p id="empty" class="muted" hidden>Keine Aufgabe passt. Lockere die Filter.</p>
    </section>
  </div>
</Base>
<script>
  // Within "Thema" all chosen topics must match (AND). Other facets allow one choice each.
  const cards = [...document.querySelectorAll<HTMLElement>('.task-card')];
  const q = document.getElementById('q') as HTMLInputElement;
  const params = new URLSearchParams(location.search);
  const paramName: Record<string, string> = { grades: 'grade', topics: 'topic', gi: 'gi', format: 'format', source: 'source' };
  const state: Record<string, Set<string>> = {};
  const sets = document.querySelectorAll<HTMLFieldSetElement>('[data-facet]');

  sets.forEach((fs) => {
    const key = fs.dataset.facet!;
    state[key] = new Set(params.getAll(paramName[key]));
    fs.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.value!;
      const on = state[key].has(v);
      if (fs.dataset.mode === 'one') state[key].clear();
      on ? state[key].delete(v) : state[key].add(v);
      apply();
    }));
  });
  // a topic in the URL implies its GI area for the topic list
  q.value = params.get('q') ?? '';

  function apply() {
    const gi = [...state.gi][0];
    // show only topics of the chosen GI area; drop chosen topics outside it
    document.querySelectorAll<HTMLElement>('[data-gi-group]').forEach((g) => {
      const visible = !gi || g.dataset.giGroup === gi;
      g.hidden = !visible;
      if (!visible) g.querySelectorAll<HTMLButtonElement>('button').forEach((b) => state.topics.delete(b.dataset.value!));
    });
    sets.forEach((fs) => fs.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
      b.setAttribute('aria-pressed', String(state[fs.dataset.facet!].has(b.dataset.value!)))));

    const text = q.value.trim().toLowerCase();
    let n = 0;
    for (const c of cards) {
      const has = (key: string) => (c.dataset[key] ?? '').split(' ');
      let ok = !text || c.dataset.text!.includes(text);
      if (ok && state.topics.size) ok = [...state.topics].every((t) => has('topics').includes(t));
      for (const key of ['grades', 'gi', 'format', 'source']) {
        if (ok && state[key].size) ok = [...state[key]].some((v) => has(key).includes(v));
      }
      c.hidden = !ok;
      if (ok) n++;
    }
    // Topic chips: how many of the currently shown tasks have this topic; 0 → disabled.
    const visible = cards.filter((c) => !c.hidden);
    document.querySelectorAll<HTMLButtonElement>('[data-facet="topics"] button').forEach((b) => {
      const v = b.dataset.value!;
      const k = state.topics.has(v) ? visible.length : visible.filter((c) => c.dataset.topics!.split(' ').includes(v)).length;
      let badge = b.querySelector('.n');
      if (!badge) { badge = document.createElement('span'); badge.className = 'n'; b.append(badge); }
      badge.textContent = String(k);
      b.disabled = k === 0 && !state.topics.has(v);
    });
    document.getElementById('count')!.textContent = String(n);
    document.getElementById('empty')!.hidden = n > 0;
    const url = new URL(location.href);
    url.search = '';
    for (const [k, s] of Object.entries(state)) s.forEach((v) => url.searchParams.append(paramName[k], v));
    if (text) url.searchParams.set('q', text);
    history.replaceState(null, '', url);
  }
  q.addEventListener('input', apply);
  document.getElementById('reset')!.addEventListener('click', () => {
    Object.values(state).forEach((s) => s.clear()); q.value = ''; apply();
  });
  apply();
</script>
<style>
  .catalog { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 28px; padding-block: 20px 0; }
  .facets { display: grid; gap: 18px; align-content: start; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; min-width: 0; }
  legend { font: 700 .75rem var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .stack { display: grid; gap: 6px; }
  .chip.wide { justify-content: flex-start; text-align: left; border-radius: 10px; padding: 6px 11px; }
  .chip[aria-pressed="true"] { background: var(--primary); color: var(--primary-ink); border-color: var(--primary); }
  .group { display: grid; gap: 6px; }
  .chip :global(.n) { font-weight: 500; opacity: .7; font-variant-numeric: tabular-nums; }
  .chip:disabled { opacity: .4; cursor: default; }
  .chip:disabled:hover { background: transparent; color: var(--ink); }
  .group[hidden] { display: none; }
  .group + .group { margin-top: 6px; }
  .sub { font-size: .8rem; color: var(--muted); }
  .note { font-size: .78rem; color: var(--muted); }
  .more summary { cursor: pointer; font-weight: 700; font-size: .9rem; color: var(--primary); }
  .more[open] { display: grid; gap: 14px; }
  .results { display: grid; gap: 16px; align-content: start; min-width: 0; }
  .head { display: grid; gap: 10px; }
  h1 { font-size: 2rem; }
  .search { display: flex; align-items: center; gap: 8px; border: 2px solid var(--line); border-radius: 999px; padding: 9px 16px; background: var(--surface); }
  .search:focus-within { border-color: var(--primary); }
  .search input { border: 0; background: transparent; font: inherit; color: var(--ink); flex: 1; min-width: 0; outline: none; }
  .count { font-size: .9rem; }
  .linkish { background: none; border: 0; padding: 0; color: var(--primary); text-decoration: underline; cursor: pointer; font: inherit; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .grid :global([hidden]) { display: none; }
  @media (max-width: 760px) { .catalog { grid-template-columns: 1fr; } }
</style>
